#!/usr/bin/env bash
# commit-msg hook: enforce impact checklist in commit messages.
# Every commit must include a "Checked:" trailer listing the impact areas
# the committer reviewed. Items not relevant can be marked [~] (N/A).
#
# Format (append after commit body, separated by a blank line):
#
#   Checked: versioning, i18n, docs, readme, tests, welcome, xss
#
# Or for partial relevance:
#
#   Checked: versioning, i18n, docs [~], readme [~], tests, welcome [~], xss
#
# The hook verifies every required tag appears (with or without [~]).
# To see the full checklist reference, run: cat COMMIT_CHECKLIST.md

set -euo pipefail

MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

# Skip merge commits and fixup/squash commits
if echo "$MSG" | head -1 | grep -qE '^(Merge |fixup! |squash! )'; then
  exit 0
fi

# Required checklist tags (short keys)
REQUIRED_TAGS=(
  versioning
  i18n
  docs
  readme
  checklist
  tests
  welcome
  prompts
  xss
  no-emoji
)

# Extract the Checked: line(s) — may span multiple lines if wrapped
CHECKED_LINE=$(echo "$MSG" | grep -i '^Checked:' | head -1 || true)

if [ -z "$CHECKED_LINE" ]; then
  echo "" >&2
  echo "══════════════════════════════════════════════════" >&2
  echo "  Missing impact checklist in commit message." >&2
  echo "" >&2
  echo "  Add a 'Checked:' trailer listing reviewed areas:" >&2
  echo "" >&2
  echo "  Checked: versioning, i18n, docs, readme," >&2
  echo "    checklist, tests, welcome, prompts, xss, no-emoji" >&2
  echo "" >&2
  echo "  Mark irrelevant items with [~]:" >&2
  echo "    docs [~], welcome [~]" >&2
  echo "" >&2
  echo "  See COMMIT_CHECKLIST.md for the full reference." >&2
  echo "══════════════════════════════════════════════════" >&2
  echo "" >&2
  exit 1
fi

# Normalize: lowercase, strip [~], collapse whitespace
CHECKED_NORM=$(echo "$CHECKED_LINE" | tr '[:upper:]' '[:lower:]' | sed 's/\[~\]//g; s/checked://; s/,/ /g' | xargs)

MISSING=()
for tag in "${REQUIRED_TAGS[@]}"; do
  if ! echo " $CHECKED_NORM " | grep -qi " $tag "; then
    MISSING+=("$tag")
  fi
done

if [ ${#MISSING[@]} -gt 0 ]; then
  echo "" >&2
  echo "══════════════════════════════════════════════════" >&2
  echo "  Checklist incomplete. Missing:" >&2
  for m in "${MISSING[@]}"; do
    echo "    - $m" >&2
  done
  echo "" >&2
  echo "  Add them to the 'Checked:' line (use [~] if N/A)." >&2
  echo "  See COMMIT_CHECKLIST.md for details." >&2
  echo "══════════════════════════════════════════════════" >&2
  echo "" >&2
  exit 1
fi

exit 0
