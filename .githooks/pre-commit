#!/usr/bin/env bash
# Pre-commit hook: enforce VERSION file is updated and consistent
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
VERSION_FILE="$REPO_ROOT/VERSION"
VERSION_JS="$REPO_ROOT/js/version.js"

if [ ! -f "$VERSION_FILE" ]; then
  echo "ERROR: VERSION file missing" >&2
  exit 1
fi

# Check that VERSION is staged (committer must have touched it)
if ! git diff --cached --name-only | grep -q '^VERSION$'; then
  echo "" >&2
  echo "══════════════════════════════════════════════════" >&2
  echo "  VERSION file not updated." >&2
  echo "" >&2
  echo "  Before committing, bump 'latest' in VERSION." >&2
  echo "  If this commit changes the DB schema, also" >&2
  echo "  update latest_compat / latest_compat_deprec." >&2
  echo "══════════════════════════════════════════════════" >&2
  echo "" >&2
  exit 1
fi

# Convert XXX.YYY to integer (XXX * 1000 + YYY) for comparison
ver_to_int() {
  local major minor
  major=$(echo "$1" | cut -d. -f1)
  minor=$(echo "$1" | cut -d. -f2)
  major=$((10#$major))
  minor=$((10#$minor))
  echo $(( major * 1000 + minor ))
}

# Validate format: must be digits.digits
validate_format() {
  if ! [[ "$1" =~ ^[0-9]+\.[0-9]+$ ]]; then
    echo "ERROR: '$2' must be in X.YYY format, got '$1'" >&2
    exit 1
  fi
}

# Parse values
latest=$(grep '^latest=' "$VERSION_FILE" | head -1 | cut -d= -f2)
latest_compat=$(grep '^latest_compat=' "$VERSION_FILE" | cut -d= -f2)
latest_compat_deprec=$(grep '^latest_compat_deprec=' "$VERSION_FILE" | cut -d= -f2)

# Validate format
validate_format "$latest" "latest"
validate_format "$latest_compat" "latest_compat"
validate_format "$latest_compat_deprec" "latest_compat_deprec"

# Convert to ints for comparison
lat_int=$(ver_to_int "$latest")
compat_int=$(ver_to_int "$latest_compat")
deprec_int=$(ver_to_int "$latest_compat_deprec")

# Validate ordering: latest_compat_deprec <= latest_compat <= latest
if [ "$deprec_int" -gt "$compat_int" ]; then
  echo "ERROR: latest_compat_deprec ($latest_compat_deprec) > latest_compat ($latest_compat)" >&2
  exit 1
fi
if [ "$compat_int" -gt "$lat_int" ]; then
  echo "ERROR: latest_compat ($latest_compat) > latest ($latest)" >&2
  exit 1
fi

# Check that latest increased vs the committed version
prev_latest=$(git show HEAD:VERSION 2>/dev/null | grep '^latest=' | head -1 | cut -d= -f2 || echo "0.000")
# Handle format transition: if prev doesn't have a dot, treat as 0.000
if ! [[ "$prev_latest" =~ \. ]]; then
  prev_latest="0.000"
fi
prev_int=$(ver_to_int "$prev_latest")
if [ "$lat_int" -le "$prev_int" ]; then
  echo "ERROR: 'latest' must increase (was $prev_latest, got $latest)" >&2
  exit 1
fi

# Regenerate js/version.js and update sw.js cache version, then stage them
cat > "$VERSION_JS" <<EOF
// Auto-generated by pre-commit hook from VERSION — do not edit manually
export const APP_VERSION = '${latest}';
export const LATEST_COMPAT = '${latest_compat}';
export const LATEST_COMPAT_DEPREC = '${latest_compat_deprec}';
EOF

# Update CACHE_VERSION in sw.js
sed -i "s/^const CACHE_VERSION = .*/const CACHE_VERSION = 'dlc-${latest}';/" "$REPO_ROOT/sw.js"

git add "$VERSION_JS" "$REPO_ROOT/sw.js"

# ── No-emoji lint ──────────────────────────────────────────────
# Scan staged diffs in JS/HTML/CSS for pictographic emoji (U+1F300+).
# Basic UI symbols (✓ ✕ ▶ etc.) are allowed.
EMOJI_HITS=$(git diff --cached --unified=0 -- '*.js' '*.html' '*.css' \
  | grep '^+' | grep -v '^+++' \
  | python3 -c "
import sys, re
emoji_re = re.compile(r'[\U0001F300-\U0001FAFF\U0001F600-\U0001F64F\U0001F680-\U0001F6FF\U0001F900-\U0001F9FF\U0001FA00-\U0001FA6F\U0001FA70-\U0001FAFF]')
found = False
for line in sys.stdin:
    if emoji_re.search(line):
        print(line.rstrip()[:120])
        found = True
sys.exit(1 if found else 0)
" 2>&1) || {
  echo "" >&2
  echo "══════════════════════════════════════════════════" >&2
  echo "  Emoji detected in staged code:" >&2
  echo "$EMOJI_HITS" | head -5 >&2
  echo "" >&2
  echo "  Use Lucide icons via lucideIcon() instead." >&2
  echo "══════════════════════════════════════════════════" >&2
  echo "" >&2
  exit 1
}
