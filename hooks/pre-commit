#!/bin/sh
# ── VERSION guard ──
# Block commit if VERSION file is not staged (forces intentional version bump).
STAGED=$(git diff --cached --name-only)
if [ -z "$STAGED" ]; then
  exit 0
fi
# Only enforce when app files are changing (skip docs-only, CI, etc.)
APP_FILES=$(echo "$STAGED" | grep -E '\.(js|css|html|sql)$' | grep -v '^sw\.js$' | grep -v '^js/version\.js$')
if [ -n "$APP_FILES" ]; then
  if ! echo "$STAGED" | grep -q '^VERSION$'; then
    echo ""
    echo "ERROR: VERSION not bumped."
    echo "Bump 'latest' in VERSION before committing."
    echo "Staged app files: $(echo "$APP_FILES" | tr '\n' ' ')"
    echo ""
    exit 1
  fi
fi

# ── Sync VERSION → js/version.js ──
if echo "$STAGED" | grep -q '^VERSION$'; then
  VER=$(grep '^latest=' VERSION | cut -d= -f2)
  COMPAT=$(grep '^latest_compat=' VERSION | cut -d= -f2)
  DEPREC=$(grep '^latest_compat_deprec=' VERSION | cut -d= -f2)
  cat > js/version.js <<EOF
// Auto-generated by pre-commit hook from VERSION — do not edit manually
export const APP_VERSION = '${VER}';
export const LATEST_COMPAT = '${COMPAT}';
export const LATEST_COMPAT_DEPREC = '${DEPREC}';
EOF
  git add js/version.js
fi

# ── SW cache version auto-bump ──
if echo "$STAGED" | grep -qE '\.(js|css)$'; then
  NON_SW=$(echo "$STAGED" | grep -E '\.(js|css)$' | grep -v '^sw\.js$')
  if [ -n "$NON_SW" ]; then
    HASH=$(git diff --cached -- '*.js' '*.css' | md5sum | cut -c1-8)
    sed -i "s/^const CACHE_VERSION = '.*';/const CACHE_VERSION = 'last-${HASH}';/" sw.js
    git add sw.js
  fi
fi
